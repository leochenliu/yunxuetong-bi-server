# ============ 事实存储 ============
# SQLite 默认事实库路径；设置 BI_DATABASE_URL 后使用 PostgreSQL
BI_DB_PATH=./data/store/bi.sqlite3
# 示例：postgresql://用户名:密码@localhost:5432/yunxuetong_bi
# 不要将生产密码提交到仓库
BI_DATABASE_URL=
# 配置目录（主键 / 字段映射 / 差分规则 / 指标定义）
BI_CONFIG_DIR=./config
# 数据入站根目录：<root>/<batch>/<项目>.xlsx
BI_INBOUND_DIR=./data/inbound

# ============ 隐私 ============
# 是否在事实库中明文保存证件号码。默认 false：
# 仅存 sha256 摘要 + 掩码（前 6 后 4），证据追溯走摘要，不回写明文。
BI_STORE_PII_PLAINTEXT=false

# ============ API（阶段三）============
BI_API_HOST=127.0.0.1
BI_API_PORT=8787

# ============ MCP 权限（阶段四）============
# 单次查询返回的硬上限，任何调用方传入更大的 limit 都会被截断到该值
BI_MCP_MAX_LIMIT=200
# 审计日志是否落库
BI_AUDIT_ENABLED=true

# ============ Agent（阶段五）============
# 留空则使用内置的离线确定性 planner；填入则走 LLM planner
BI_LLM_BASE_URL=
BI_LLM_API_KEY=
BI_LLM_MODEL=
